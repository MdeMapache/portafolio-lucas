# ─── Backend ────────────────────────────────────────────────────────────────
# Si estas dos variables están completas, la app usa Supabase (datos, archivos
# y auth). Si faltan, cae automáticamente al modo local (localStorage +
# IndexedDB) y sigue funcionando sin backend. No hay que tocar código.
#
# Copiá este archivo a .env.local y completalo. .env.local está en .gitignore.
#
# Ambas son públicas por diseño: viajan en el bundle del navegador. Lo que
# protege los datos son las policies RLS — ver supabase-setup.sql.
# La key `service_role` NUNCA va acá: cualquier NEXT_PUBLIC_ es visible.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ─── Sólo modo local ────────────────────────────────────────────────────────
# Frase para entrar al panel de edición cuando no hay Supabase configurado.
# Por defecto: "dev".
#
# Esto NO es seguridad: está en el bundle del cliente. Existe para que el flujo
# de login sea el mismo con y sin backend. En modo local no hay nada que
# proteger igual, porque los datos viven en el navegador de cada visitante.

NEXT_PUBLIC_DEV_PASSPHRASE=dev
